{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 11 - Dot map: each dot is a ~10 x 10 km area (0.1 degree) where cane toads have been recorded, coloured by the first year a record appeared. The slider replays the spread.",
  "width": "container",
  "height": 430,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "params": [
    {
      "name": "upto",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 1935,
        "max": 2025,
        "step": 1,
        "name": "Show areas first recorded up to: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E9EEE7",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/canetoad.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "first_year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.first_year <= upto"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 9,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "first_year",
          "type": "quantitative",
          "scale": {
            "domain": [
              1935,
              2025
            ],
            "range": [
              "#FAD7B5",
              "#E0782B",
              "#7F2A06"
            ]
          },
          "legend": {
            "title": "First year recorded",
            "format": "d",
            "orient": "bottom-left",
            "gradientLength": 160
          }
        },
        "tooltip": [
          {
            "field": "first_year",
            "title": "First recorded"
          },
          {
            "field": "lat",
            "title": "Latitude"
          },
          {
            "field": "lon",
            "title": "Longitude"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/canetoad_notes.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "shape": "triangle-down",
            "size": 60,
            "filled": true,
            "color": "#17261F"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          },
          "layer": [
            {
              "mark": {
                "type": "text",
                "dy": -12,
                "fontSize": 11.5,
                "fontWeight": "bold",
                "color": "#FFFFFF",
                "stroke": "#FFFFFF",
                "strokeWidth": 3.5,
                "strokeJoin": "round"
              }
            },
            {
              "mark": {
                "type": "text",
                "dy": -12,
                "fontSize": 11.5,
                "fontWeight": "bold",
                "color": "#17261F"
              }
            }
          ]
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "x": 0
          }
        ]
      },
      "mark": {
        "type": "text",
        "text": {
          "expr": "upto"
        },
        "x": {
          "expr": "width - 8"
        },
        "y": 30,
        "align": "right",
        "fontSize": 44,
        "fontWeight": "bold",
        "color": "#C0561C",
        "opacity": 0.85
      }
    }
  ]
}
