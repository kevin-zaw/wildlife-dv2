{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 3 - Marimekko chart: column width = state's share of 2025 records; segment height = share from each source.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/state_source.csv",
    "format": {
      "type": "csv",
      "parse": {
        "records": "number",
        "order": "number"
      }
    }
  },
  "transform": [
    {
      "stack": "records",
      "groupby": [],
      "as": [
        "s1",
        "s2"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "code",
          "order": "ascending"
        }
      ]
    },
    {
      "window": [
        {
          "op": "min",
          "field": "s1",
          "as": "x"
        },
        {
          "op": "max",
          "field": "s2",
          "as": "x2"
        }
      ],
      "groupby": [
        "code"
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "stack": "records",
      "groupby": [
        "code"
      ],
      "as": [
        "y",
        "y2"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "order",
          "order": "ascending"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "records",
          "as": "state_total"
        }
      ],
      "groupby": [
        "code"
      ]
    },
    {
      "calculate": "datum.records / datum.state_total",
      "as": "share"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": {
            "format": "%",
            "title": "Share of all 2025 records (column width)",
            "tickCount": 5,
            "grid": false
          }
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": {
            "format": "%",
            "title": "Share within state",
            "tickCount": 5
          }
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "source",
          "type": "nominal",
          "sort": {
            "field": "order",
            "op": "min"
          },
          "scale": {
            "range": [
              "#2C6E8F",
              "#D08C1A",
              "#3F8F5A",
              "#B0507A",
              "#6B5EA8",
              "#BCC3BE"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "source",
            "title": "Source"
          },
          {
            "field": "records",
            "title": "Records",
            "format": ","
          },
          {
            "field": "share",
            "title": "Share of state's records",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x",
              "as": "xa"
            },
            {
              "op": "max",
              "field": "x2",
              "as": "xb"
            }
          ],
          "groupby": [
            "code"
          ]
        },
        {
          "calculate": "(datum.xa + datum.xb) / 2",
          "as": "xm"
        },
        {
          "calculate": "datum.xb - datum.xa > 0.035 ? datum.code : ''",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "y": -4,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#17261F"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    }
  ]
}
