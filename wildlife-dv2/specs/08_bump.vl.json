{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 8 - Bump chart: rank of the ten most-recorded species each year, 2016-2025. Colour = group. Hover to follow one species.",
  "width": "container",
  "height": 360,
  "padding": {
    "left": 5,
    "right": 165,
    "top": 5,
    "bottom": 5
  },
  "data": {
    "url": "data/species_rank.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "rank": "number",
        "records": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "sort": "ascending",
      "axis": {
        "title": "Rank (1 = most recorded)",
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Birds",
          "Frogs",
          "Insects",
          "Reptiles",
          "Fungi",
          "Mammals",
          "Plants",
          "Other animals"
        ],
        "range": [
          "#0072B2",
          "#009E73",
          "#E69F00",
          "#8A6A36",
          "#CC79A7",
          "#7B68A6",
          "#97A33C",
          "#9FB3C2"
        ]
      },
      "legend": null
    },
    "opacity": {
      "condition": {
        "param": "hover",
        "empty": true,
        "value": 1
      },
      "value": 0.12
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "interpolate": "monotone"
      },
      "encoding": {
        "detail": {
          "field": "species"
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "species"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "common_name",
            "title": "Species"
          },
          {
            "field": "species",
            "title": "Scientific name"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "records",
            "title": "Records",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "year",
              "as": "last"
            }
          ]
        },
        {
          "filter": "datum.year == datum.last"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11.5
      },
      "encoding": {
        "text": {
          "field": "common_name"
        }
      }
    }
  ]
}
