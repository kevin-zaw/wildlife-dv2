{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 4 - Choropleth map: 2025 wildlife records per 1,000 residents (ALA records / ABS population). Albers equal-area conic projection. Class breaks = quartiles, set by scripts/get_data.py.",
  "width": "container",
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "params": [
    {
      "name": "brk",
      "value": [
        290,
        330,
        580
      ]
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "lookup": "properties.code",
          "from": {
            "data": {
              "url": "data/state_rate.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "records": "number",
                  "population": "number",
                  "rate": "number"
                }
              }
            },
            "key": "code",
            "fields": [
              "state",
              "records",
              "population",
              "rate"
            ]
          }
        },
        {
          "calculate": "datum.rate < brk[0] ? 0 : datum.rate < brk[1] ? 1 : datum.rate < brk[2] ? 2 : 3",
          "as": "ci"
        },
        {
          "calculate": "['Under ' + format(brk[0], ','), format(brk[0], ',') + '–' + format(brk[1], ','), format(brk[1], ',') + '–' + format(brk[2], ','), format(brk[2], ',') + ' or more'][datum.ci]",
          "as": "cls"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "cls",
          "type": "nominal",
          "scale": {
            "domain": [
              "Under 290",
              "290–330",
              "330–580",
              "580 or more"
            ],
            "range": [
              "#DCEBD5",
              "#95C592",
              "#4C9A64",
              "#1C5A3D"
            ]
          },
          "legend": {
            "title": "Records per 1,000 residents",
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 200,
            "symbolStrokeWidth": 0,
            "columnPadding": 14
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State or territory"
          },
          {
            "field": "records",
            "title": "Records in 2025",
            "format": ","
          },
          {
            "field": "population",
            "title": "Residents (ABS, Dec 2025)",
            "format": ","
          },
          {
            "field": "rate",
            "title": "Records per 1,000 residents",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "code": "WA",
            "lon": 121.5,
            "lat": -25.5
          },
          {
            "code": "NT",
            "lon": 133.4,
            "lat": -19.5
          },
          {
            "code": "SA",
            "lon": 135.2,
            "lat": -30.2
          },
          {
            "code": "QLD",
            "lon": 144.2,
            "lat": -22.8
          },
          {
            "code": "NSW",
            "lon": 146.4,
            "lat": -32.4
          },
          {
            "code": "VIC",
            "lon": 144.0,
            "lat": -36.9
          },
          {
            "code": "TAS",
            "lon": 146.6,
            "lat": -42.1
          },
          {
            "code": "ACT",
            "lon": 153.2,
            "lat": -35.9
          }
        ]
      },
      "transform": [
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/state_rate.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "rate": "number"
                }
              }
            },
            "key": "code",
            "fields": [
              "rate"
            ]
          }
        },
        {
          "calculate": "datum.code + ' ' + format(datum.rate, ',.0f')",
          "as": "lab"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#FFFFFF",
            "stroke": "#FFFFFF",
            "strokeWidth": 3.5,
            "strokeJoin": "round",
            "opacity": 0.9
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "lab"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#17261F"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "lab"
            }
          }
        }
      ]
    }
  ]
}
