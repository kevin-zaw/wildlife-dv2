{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 10 - Radial (polar area) small multiples: share of each group's records falling in each month, 2021-2025 combined. Each month is an equal 30-degree wedge; wedge length (radius) = share. January at the top, then clockwise.",
  "data": {
    "url": "data/month_group.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month": "number",
        "records": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "records",
          "as": "total"
        }
      ],
      "groupby": [
        "group"
      ]
    },
    {
      "calculate": "datum.records / datum.total",
      "as": "share"
    },
    {
      "calculate": "datum.month - 1",
      "as": "t0"
    },
    {
      "calculate": "datum.month",
      "as": "t1"
    },
    {
      "calculate": "datum.month - 0.5",
      "as": "tmid"
    },
    {
      "calculate": "['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][datum.month - 1]",
      "as": "mon"
    },
    {
      "calculate": "slice(datum.mon, 0, 1)",
      "as": "initial"
    }
  ],
  "facet": {
    "field": "group",
    "type": "nominal",
    "title": null,
    "sort": [
      "Birds",
      "Frogs",
      "Insects",
      "Reptiles",
      "Fungi"
    ],
    "header": {
      "labelFontSize": 15,
      "labelFontWeight": "bold",
      "labelPadding": 4
    }
  },
  "columns": 5,
  "spacing": 22,
  "spec": {
    "width": 150,
    "height": 150,
    "layer": [
      {
        "mark": {
          "type": "arc",
          "fill": null,
          "stroke": "#D5DDD6",
          "strokeWidth": 1
        },
        "encoding": {
          "theta": {
            "field": "t0",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                12
              ]
            }
          },
          "theta2": {
            "field": "t1"
          },
          "radius": {
            "value": 66
          }
        }
      },
      {
        "params": [
          {
            "name": "m",
            "select": {
              "type": "point",
              "fields": [
                "month"
              ],
              "on": "pointerover",
              "clear": "pointerout"
            }
          }
        ],
        "mark": {
          "type": "arc",
          "stroke": "#FFFFFF",
          "strokeWidth": 1
        },
        "encoding": {
          "theta": {
            "field": "t0",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                12
              ]
            }
          },
          "theta2": {
            "field": "t1"
          },
          "radius": {
            "field": "share",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "zero": true,
              "rangeMin": 0,
              "rangeMax": 66
            }
          },
          "color": {
            "field": "group",
            "type": "nominal",
            "scale": {
              "domain": [
                "Birds",
                "Frogs",
                "Insects",
                "Reptiles",
                "Fungi",
                "Mammals",
                "Plants",
                "Other animals"
              ],
              "range": [
                "#0072B2",
                "#009E73",
                "#E69F00",
                "#8A6A36",
                "#CC79A7",
                "#7B68A6",
                "#97A33C",
                "#9FB3C2"
              ]
            },
            "legend": null
          },
          "opacity": {
            "condition": {
              "param": "m",
              "empty": true,
              "value": 1
            },
            "value": 0.3
          },
          "tooltip": [
            {
              "field": "group",
              "title": "Group"
            },
            {
              "field": "mon",
              "title": "Month"
            },
            {
              "field": "share",
              "title": "Share of the year's records",
              "format": ".1%"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "radius": 76,
          "fontSize": 10,
          "color": "#56645C"
        },
        "encoding": {
          "theta": {
            "field": "tmid",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                12
              ]
            }
          },
          "text": {
            "field": "initial"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "radius": "shared"
    }
  }
}
