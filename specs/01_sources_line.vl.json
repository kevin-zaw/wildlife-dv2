{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 1 - Multi-line chart: records added to the ALA each year by the five largest data sources, 2010-2025.",
  "width": "container",
  "height": 340,
  "layer": [
    {
      "data": {
        "url": "data/year_source.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "records": "number",
            "order": "number"
          }
        }
      },
      "params": [
        {
          "name": "src",
          "select": {
            "type": "point",
            "fields": [
              "source"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "size": 28,
          "filled": true
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2010,
              2025
            ],
            "nice": false
          },
          "axis": {
            "format": "d",
            "title": null,
            "tickCount": 8,
            "grid": false
          }
        },
        "y": {
          "field": "records",
          "type": "quantitative",
          "axis": {
            "format": "~s",
            "title": "Records added per year",
            "tickCount": 5
          }
        },
        "color": {
          "field": "source",
          "type": "nominal",
          "sort": {
            "field": "order",
            "op": "min"
          },
          "scale": {
            "range": [
              "#2C6E8F",
              "#D08C1A",
              "#3F8F5A",
              "#B0507A",
              "#6B5EA8",
              "#BCC3BE"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "columns": 3,
            "symbolType": "stroke",
            "symbolStrokeWidth": 3,
            "labelLimit": 260
          }
        },
        "opacity": {
          "condition": {
            "param": "src",
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "source",
            "title": "Source"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "records",
            "title": "Records",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2017.86,
            "label": "FrogID app launches (Nov 2017)",
            "y": 4,
            "a": "right",
            "dx": -5
          },
          {
            "x": 2020.2,
            "label": "COVID-19 lockdowns begin (Mar 2020)",
            "y": 22,
            "a": "left",
            "dx": 5
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [
              3,
              3
            ],
            "color": "#6B7770"
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.a == 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "top",
            "dx": -5,
            "y": 4,
            "fontSize": 11.5,
            "color": "#44514A"
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.a == 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 5,
            "y": 4,
            "fontSize": 11.5,
            "color": "#44514A"
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ]
}
