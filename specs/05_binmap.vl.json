{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 5 - Bin map: 2025 records counted in 1-degree grid cells (about 100 x 100 km). Dropdown filters by group. Albers equal-area conic projection.",
  "width": "container",
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "params": [
    {
      "name": "group",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Birds",
          "Frogs",
          "Insects",
          "Reptiles",
          "Fungi"
        ],
        "labels": [
          "All wildlife",
          "Birds",
          "Frogs",
          "Insects",
          "Reptiles",
          "Fungi"
        ],
        "name": "Show records of: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E9EEE7",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/grid.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties[group]",
          "as": "val"
        },
        {
          "filter": "datum.val > 0"
        },
        {
          "calculate": "datum.val < 10 ? 0 : datum.val < 100 ? 1 : datum.val < 1000 ? 2 : datum.val < 10000 ? 3 : 4",
          "as": "ci"
        },
        {
          "calculate": "['1–9', '10–99', '100–999', '1,000–9,999', '10,000 or more'][datum.ci]",
          "as": "cls"
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeWidth": 0
      },
      "encoding": {
        "color": {
          "field": "cls",
          "type": "nominal",
          "scale": {
            "domain": [
              "1–9",
              "10–99",
              "100–999",
              "1,000–9,999",
              "10,000 or more"
            ],
            "range": [
              "#E4EFDF",
              "#B3D4A6",
              "#72B07A",
              "#378757",
              "#17563A"
            ]
          },
          "legend": {
            "title": "Records per grid square (each class is ten times the one before)",
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 200,
            "symbolStrokeWidth": 0,
            "columnPadding": 12,
            "titleLimit": 480
          }
        },
        "tooltip": [
          {
            "field": "properties.lat",
            "title": "Cell centre latitude"
          },
          {
            "field": "properties.lon",
            "title": "Cell centre longitude"
          },
          {
            "field": "val",
            "title": "Records",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/capitals.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 18,
            "color": "#17261F"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "fontSize": 10.5,
            "color": "#FFFFFF",
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "fontSize": 10.5,
            "color": "#17261F"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 131.5,
            "lat": -26.8,
            "t": "Few records across"
          },
          {
            "lon": 131.5,
            "lat": -28.3,
            "t": "the arid interior"
          }
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontStyle": "italic",
            "fontWeight": "bold",
            "color": "#FFFFFF",
            "stroke": "#FFFFFF",
            "strokeWidth": 4,
            "strokeJoin": "round"
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontStyle": "italic",
            "fontWeight": "bold",
            "color": "#17261F"
          }
        }
      ]
    }
  ]
}
